{
  "name": "eve-curtiumuitoisso",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Eve curtiu isso! — site estático (Vite) hospedado no Cloudflare Workers",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && wrangler dev",
    "images": "node scripts/optimize-images.mjs",
    "deploy": "vite build && wrangler deploy",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.8",
    "wrangler": "^4.164.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
