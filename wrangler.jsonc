// Cloudflare Workers — Static Assets (sem código de servidor)
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eve-curtiumuitoisso-lol",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "routes": [
    { "pattern": "eve-curtiumuitoisso.lol", "custom_domain": true },
    { "pattern": "www.eve-curtiumuitoisso.lol", "custom_domain": true },
  ],
  "workers_dev": true,
  "observability": { "enabled": false },
}
